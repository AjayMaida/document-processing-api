APP_NAME=Document Processing API
APP_ENV=development
DEBUG=True

API_PREFIX=/api/v1

SECRET_KEY=CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

