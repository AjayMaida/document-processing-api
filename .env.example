DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/document_processing
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/document_processing_test_db

UPLOAD_DIR=uploads
EXTRACTED_TEXT_DIR=extracted_texts

ALLOWED_EXTENSIONS=[".pdf",".docx",".txt"]
ALLOWED_CONTENT_TYPES=["application/pdf","application/vnd.openxmlformats-officedocument.wordprocessingml.document","text/plain"]

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
